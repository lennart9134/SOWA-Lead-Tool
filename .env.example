# Diese Variablen in den Vercel-Projekt-Settings → Environment Variables
# eintragen. Sie bleiben serverseitig — nie im Browser/Client.

# BetterContact-API-Key (treibt Suche UND Anreicherung)
BETTERCONTACT_API_KEY=

# Geteiltes Zugangspasswort für die Reps (frei wählbar, z. B. lang & zufällig)
APP_PASSWORD=

# ── CRM-Auswahl ──
# "hubspot" (Standard, auch wenn die Variable leer/nicht gesetzt ist) oder "twenty".
CRM_PROVIDER=hubspot

# Nur nötig, wenn CRM_PROVIDER=hubspot:
# HubSpot Private-App-Token (Scopes: crm.objects.contacts.read + write)
HUBSPOT_TOKEN=

# Nur nötig, wenn CRM_PROVIDER=twenty:
# Basis-URL deiner Twenty-Instanz OHNE /rest (Cloud: https://api.twenty.com,
# selbst gehostet: https://deine-domain.tld)
TWENTY_API_URL=
# API-Key aus Twenty: Einstellungen → API & Webhooks → "+ Create key"
TWENTY_API_KEY=
