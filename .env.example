# Diese drei Variablen in den Vercel-Projekt-Settings → Environment Variables
# eintragen. Sie bleiben serverseitig — nie im Browser/Client.

# BetterContact-API-Key (treibt Suche UND Anreicherung)
BETTERCONTACT_API_KEY=

# HubSpot Private-App-Token (Scopes: crm.objects.contacts.read + write)
HUBSPOT_TOKEN=

# Geteiltes Zugangspasswort für die Reps (frei wählbar, z. B. lang & zufällig)
APP_PASSWORD=
